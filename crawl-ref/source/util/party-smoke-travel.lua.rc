<
-- Ctrl+G to the next floor down: player 1 travels to the stairs, player 2
-- follows automatically, and the whole party arrives together.
local step = 0
local passes = 0
local function d(code) return crawl.call_dlua(code) end
local function log(s) crawl.stderr("SMOKE " .. s .. "\n") end
local function state()
  return d([[local x1,y1 = party.pos(1); local x2,y2 = party.pos(2)
    return string.format("size=%d active=%d p1=%s(%d,%d) p2=%s(%d,%d) time=%d",
      party.size(), party.active(), party.where(1), x1, y1, party.where(2), x2, y2, you.time())]])
end
function ready()
  passes = passes + 1
  if passes > 200 then log("GAVE UP " .. state()); crawl.sendkeys(string.char(17)); return end
  if step == 0 then
    log("START " .. state())
    if d("return party.size()") ~= 2 then log("FAIL party did not start"); step = 99; return end
    -- Carve a corridor away from player 2 with stairs down at its end, so
    -- player 2 has to follow player 1 there.
    -- (No monsters: one coming into view rightly stops the travel.)
    d([[
      dgn.dismiss_monsters()
      local x, y = you.pos()
      local x2, y2 = party.pos(2)
      local dx, dy = x - x2, y - y2
      dx = dx > 0 and 1 or dx < 0 and -1 or 0
      dy = dy > 0 and 1 or dy < 0 and -1 or 0
      if dx == 0 and dy == 0 then dx = 1 end
      for i = 1, 5 do dgn.grid(x + i * dx, y + i * dy, "floor") end
      dgn.grid(x + 6 * dx, y + 6 * dy, "stone_stairs_down_i")
      debug.los_changed()]])
    step = 1
    crawl.sendkeys(string.char(18))         -- Ctrl+R: redraw, maps the stairs
  elseif step == 1 then
    log("STAIRS " .. state())
    step = 2
    crawl.sendkeys(string.char(7) .. ">")   -- Ctrl+G, next level down
  elseif step == 2 then
    if d("return party.where(1)") == "D:2" then
      log("ARRIVED " .. state())
      local same = d([[return party.where(1) == party.where(2)]])
      log(same and "PASS party travelled together to D:2"
               or "FAIL player 2 left behind")
      step = 99
    else
      log("FAIL asked for input on D:1 during travel: " .. state() .. " | "
          .. crawl.messages(6):gsub("\n", " | "))
      step = 99
    end
  elseif step == 99 then
    log("DONE")
    step = 100
  end
end
>
