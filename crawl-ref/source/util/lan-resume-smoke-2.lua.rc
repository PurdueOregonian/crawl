<
-- Host side of util/lan-resume-smoke.ps1, run 2: the save is loaded (and,
-- since player 2 was on another computer, hosted again). Once the client has
-- rejoined, play a round: it only completes if player 2 is played from the
-- client.
local step = 0
local passes = 0
local t0
local function d(code) return crawl.call_dlua(code) end
local function log(s) crawl.stderr("SMOKE " .. s .. "\n") end
local function state()
  return d([[local s = string.format("size=%d active=%d", party.size(), party.active())
    for i = 1, party.size() do
      local x, y = party.pos(i)
      s = s .. string.format(" | p%d %s hp=%d at (%d,%d)", i,
        party.species(i), party.hp(i), x, y)
    end
    return s]])
end
function ready()
  passes = passes + 1
  if passes > 100 then log("GAVE UP " .. state()); return end
  if d("return party.active()") ~= 1 then return end   -- the client's turn
  if step == 0 then
    log("AFTER " .. state())
    t0 = d("return you.time()")
    step = 1
    crawl.sendkeys("s")
  elseif step == 1 then
    if d("return you.time()") < t0 + 10 then log("FAIL the round didn't complete"); return end
    log("PASS player 2 played from the client after loading " .. state())
    step = 2
    log("DONE")
  end
end
>
